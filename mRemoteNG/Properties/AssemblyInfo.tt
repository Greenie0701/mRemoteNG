<#@ parameter name="platformType" type="System.String" #>
<#@ import namespace="System" #>
<#
    // Try parameter first, then environment variable, then default
    string platformValue = platformType;
    if (string.IsNullOrEmpty(platformValue))
    {
        platformValue = Environment.GetEnvironmentVariable("PLATFORM_TYPE") ?? "x64";
    }
    
    // Only include the problematic EnvDTE file if we still don't have a platform
    // and we're likely in a Visual Studio context (not CI/CD)
    bool isInCICD = !string.IsNullOrEmpty(Environment.GetEnvironmentVariable("GITHUB_ACTIONS"));
    
    if (string.IsNullOrEmpty(platformValue) && !isInCICD)
    {
        // Only try to include EnvDTE stuff when NOT in GitHub Actions
#>
